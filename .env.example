# Fitness Tracker Environment Variables

# Security
FERNET_KEY=           # Fernet encryption key for AI API key storage (auto-generated if empty)

# APIs
USDA_API_KEY=DEMO_KEY  # USDA FoodData Central API key (get at https://fdc.nal.usda.gov/api-key-signup)

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend
DATABASE_URL=sqlite:///./fitness.db
